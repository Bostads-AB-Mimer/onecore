{
  "name": "@onecore/core",
  "version": "1.5.0",
  "private": "true",
  "description": "",
  "license": "MIT",
  "author": "",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "dev:init": "pnpm run prepare:dotenv",
    "generate-types": "pnpm generate-types:property-base & pnpm generate-types:work-order & pnpm generate-types:inspection & pnpm generate-types:keys",
    "generate-types:keys": "npx openapi-typescript http://localhost:5092/swagger.json -o ./src/adapters/keys-adapter/generated/api-types.ts && npx prettier --write ./src/adapters/keys-adapter/generated/api-types.ts",
    "generate-types:property-base": "npx openapi-typescript http://localhost:5050/swagger.json -o ./src/adapters/property-base-adapter/generated/api-types.ts && npx prettier --write ./src/adapters/property-base-adapter/generated/api-types.ts",
    "generate-types:work-order": "npx openapi-typescript http://localhost:5070/swagger.json -o ./src/adapters/work-order-adapter/generated/api-types.ts && npx prettier --write ./src/adapters/work-order-adapter/generated/api-types.ts",
    "generate-types:inspection": "npx openapi-typescript http://localhost:5090/swagger.json -o ./src/adapters/inspection-adapter/generated/api-types.ts && npx prettier --write ./src/adapters/inspection-adapter/generated/api-types.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepare:dotenv": "[ -f .env ] || cp .env.template .env",
    "prettier": "prettier --check ./src",
    "dev:script:handle-expired-offers": "ts-node src/scripts/handle-expired-offers.ts",
    "dev:script:start-offer-batches": "ts-node src/scripts/start-offer-batches.ts",
    "dev:script:unpaid-invoice-payment-summaries": "ts-node src/scripts/unpaid-invoice-payment-summaries.ts",
    "dev:script:bosociala": "ts-node src/scripts/bosociala.ts",
    "dev:script:sync-keycloak-entra-id-attributes": "ts-node src/scripts/sync-keycloak-entra-id-attributes.ts",
    "script:handle-expired-offers": "node build/scripts/handle-expired-offers",
    "script:start-offer-batches": "node build/scripts/start-offer-batches",
    "script:unpaid-invoice-payment-summaries": "node build/scripts/unpaid-invoice-payment-summaries",
    "script:bosociala": "node build/scripts/bosociala",
    "script:sync-keycloak-entra-id-attributes": "node build/scripts/sync-keycloak-entra-id-attributes",
    "start": "node build/index.js",
    "test": "jest",
    "test:ci": "TZ=UTC jest --silent",
    "test:watch": "TZ=UTC jest --watch",
    "ts:watch": "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iteam/config": "^12.1.2",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.2",
    "@onecore/contacts": "workspace:*",
    "@onecore/types": "workspace:*",
    "@onecore/utilities": "workspace:*",
    "@types/lodash": "^4.17.25",
    "axios": "^1.19.0",
    "axios-logger": "^2.8.1",
    "date-holidays": "^3.35.0",
    "dayjs": "^1.11.21",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.6",
    "http-errors": "^2.0.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "keycloak-koa": "1.3.1",
    "koa": "^2.16.4",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-jwt": "^4.0.4",
    "koa-okapi-router": "^0.1.4",
    "koa-pino-logger": "^4.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "lodash": "^4.18.1",
    "odoo-await": "^3.4.1",
    "openapi-fetch": "^0.13.8",
    "pdfkit": "^0.17.2",
    "pino": "^9.14.0",
    "pino-elasticsearch": "^8.1.0",
    "pino-multi-stream": "^6.0.0",
    "pino-pretty": "^11.3.0",
    "striptags": "^3.2.0",
    "swagger-jsdoc": "^6.3.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^2.15.2",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-pino-logger": "3.0.4",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "12.0.4",
    "@types/ms": "^2.1.0",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.6",
    "@types/pino-multi-stream": "^5.1.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui": "^3.52.4",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-n": "17.21.3",
    "eslint-plugin-node": "^11.1.0",
    "fishery": "^2.4.0",
    "jest": "^29.7.0",
    "msw": "2.11.1",
    "nock": "^13.5.6",
    "nodemon": "^3.1.14",
    "openapi-typescript": "^6.7.6",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.42.0"
  }
}
