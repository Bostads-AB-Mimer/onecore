{
  "name": "@onecore/utilities",
  "version": "1.5.0",
  "type": "module",
  "description": "ONECore common utilities",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Bostads-AB-Mimer/onecore-utilities#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bostads-AB-Mimer/onecore-utilities.git"
  },
  "bugs": {
    "url": "https://github.com/Bostads-AB-Mimer/onecore-utilities/issues"
  },
  "author": "Anders Norrback Bornholm",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prettier": "prettier --check ./src",
    "test": "jest",
    "test:ci": "jest --silent",
    "test:watch": "jest --watch",
    "ts:watch": "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@elastic/elasticsearch": "^8.0.0",
    "@elastic/transport": "^8.0.0",
    "exceljs": "^4.4.0",
    "knex": "^3.1.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "koa": "^2.16.4",
    "pino": "^9.14.0",
    "pino-elasticsearch": "^8.1.0",
    "pino-multi-stream": "^6.0.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.9.6",
    "release-please": "^16.18.0"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.2",
    "@types/pino-multi-stream": "^5.1.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "17.21.3",
    "eslint-plugin-node": "^11.1.0",
    "exceljs": "^4.4.0",
    "jest": "^29.7.0",
    "knex": "^3.3.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
