{
  "name": "@onecore/auth",
  "version": "1.5.0",
  "type": "module",
  "description": "ONECore frontend login through core's Keycloak flow: login, callback and user hooks",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "prettier": "prettier --check ./src ./test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "react": "^18.3.1"
  },
  "dependencies": {
    "@onecore/types": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
