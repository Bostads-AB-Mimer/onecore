{
  "name": "@onecore/keys",
  "private": true,
  "version": "0.1.0",
  "description": "MIT",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "pnpm run migrate:up && pnpx nodemon -e ts,js --exec ts-node -r dotenv/config src/index",
    "dev:init": "pnpm run prepare:dotenv",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate:down": "pnpx knex migrate:down --env dev",
    "migrate:make": "pnpx knex migrate:make",
    "migrate:seed": "pnpx knex seed:run --env dev",
    "migrate:up": "pnpx knex migrate:latest --env dev",
    "prepare:dotenv": "[ -f .env ] || cp .env.template .env",
    "prettier": "prettier --check ./src",
    "start": "pnpm run migrate:up && node -r dotenv/config build/index",
    "test:create-db": "node scripts/create-test-db.js",
    "test:drop-db": "node scripts/drop-test-db.js",
    "test": "pnpm test:create-db && cross-env DOTENV_CONFIG_PATH=.env.test jest",
    "test:watch": "cross-env DOTENV_CONFIG_PATH=.env.test jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iteam/config": "^12.1.2",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.2",
    "@napi-rs/canvas": "^0.1.100",
    "@onecore/types": "workspace:*",
    "@onecore/utilities": "workspace:*",
    "@types/easy-soap-request": "^5.6.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui": "^3.52.4",
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "dax-client": "workspace:*",
    "dedent": "^1.7.2",
    "dotenv": "^16.6.1",
    "easy-soap-request": "^5.20.0",
    "fast-xml-parser": "^4.5.7",
    "fishery": "^2.4.0",
    "form-data": "^4.0.6",
    "http-errors": "^2.0.1",
    "jimp": "^1.6.1",
    "knex": "^3.3.0",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.4.1",
    "koa-pino-logger": "^4.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "minio": "^8.0.7",
    "mssql": "^11.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "personnummer": "^3.2.1",
    "pino": "^9.14.0",
    "pino-elasticsearch": "^8.1.0",
    "pino-multi-stream": "^6.0.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.9.6",
    "randexp": "^0.5.3",
    "strong-soap": "^4.1.14",
    "swagger-jsdoc": "^6.3.0",
    "tedious": "^18.6.2",
    "ts-pattern": "^5.9.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2",
    "zxing-wasm": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "9.32.0",
    "@types/apidoc": "^0.50.3",
    "@types/easy-soap-request": "^5.6.0",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.2",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-pino-logger": "3.0.4",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "12.0.4",
    "@types/node": "^20.19.43",
    "@types/pino-multi-stream": "^5.1.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/typescript-estree": "^8.67.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
