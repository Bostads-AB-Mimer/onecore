{
  "name": "@onecore/contacts",
  "version": "1.5.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./build/esm/index.d.ts",
      "require": "./build/cjs/index.cjs",
      "import": "./build/esm/index.js"
    },
    "./swagger.json": "./build/swagger.json",
    "./domain": {
      "types": "./build/esm/domain/index.d.ts"
    },
    "./schema": {
      "types": "./build/esm/schema.d.ts",
      "require": "./build/cjs/schema.cjs",
      "import": "./build/esm/schema.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "pnpm migrate:up && node -r dotenv/config --import tsx --watch src/index",
    "dev:local": "node -r dotenv/config --import tsx --watch src/index",
    "dev:init": "pnpm prepare:dotenv",
    "dev:script:import-contact-relations": "node -r dotenv/config --import tsx src/scripts/import-contact-relations/index.ts",
    "dev:apply-seed": "pnpm test:create-db && ./scripts/apply-seed.sh",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate:down": "knex migrate:down --knexfile knexfile.cjs --env development",
    "migrate:make": "knex migrate:make --knexfile knexfile.cjs",
    "migrate:up": "knex migrate:latest --knexfile knexfile.cjs",
    "prepare:dotenv": "[ -f .env ] || cp .env.template .env",
    "prettier": "prettier --check ./src",
    "start": "pnpm migrate:up && node -r dotenv/config build/esm/index",
    "test": "pnpm test:create-db && DOTENV_CONFIG_PATH=.env.test jest --detectOpenHandles",
    "test:create-db": "./scripts/create-test-db.sh",
    "test:ci": "pnpm test:create-db && DOTENV_CONFIG_PATH=.env.ci jest",
    "test:watch": "DOTENV_CONFIG_PATH=.env.test jest --watch",
    "ts:watch": "tsc --watch --noEmit",
    "typecheck": "tsc -p ./tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@iteam/config": "^12.1.2",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.2",
    "@onecore/types": "workspace:*",
    "@onecore/utilities": "workspace:*",
    "@types/swagger-ui": "^3.52.4",
    "dotenv": "^16.6.1",
    "easy-soap-request": "^5.6.1",
    "fast-xml-parser": "^4.4.0",
    "knex": "^3.3.0",
    "koa": "^2.16.4",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-okapi-router": "^0.1.4",
    "koa-pino-logger": "^4.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "mssql": "^11.0.1",
    "personnummer": "^3.2.1",
    "prettier": "^3.9.6",
    "tedious": "^18.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "9.32.0",
    "@types/easy-soap-request": "^5.6.0",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.2",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "12.0.4",
    "@types/mssql": "^9.1.11",
    "@types/node": "^20.19.43",
    "@types/pino-multi-stream": "^5.1.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/typescript-estree": "^8.69.0",
    "axios": "^1.20.0",
    "eslint": "^9.39.5",
    "fishery": "^2.4.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
