    "migrate:up": "knex migrate:latest --env dev",
    "prepare:dotenv": "[ -f .env ] || cp .env.template .env",
    "prettier": "prettier --check ./src",
    "start": "node index",
    "test": "jest",
    "test:ci": "jest --silent",
    "typecheck": "tsc --noEmit"
