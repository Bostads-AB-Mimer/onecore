  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "keywords": [],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm migrate:up && nodemon -e ts,js --exec ts-node src/index ",
    "dev:init": "pnpm prepare:dotenv",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate:down": "knex migrate:down --env development",
    "migrate:make": "knex migrate:make",
    "migrate:seed": "knex seed:run --env development",
    "migrate:up": "knex migrate:latest",
    "prepare:dotenv": "[ -f .env ] || cp .env.template .env",
    "prettier": "prettier --check ./src",
    "start": "pnpm migrate:up && node build/index",
    "test": "jest",
    "test:ci": "jest --silent",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@infobip-api/sdk": "^0.3.2",
    "@iteam/config": "^12.1.2",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.2",
    "@onecore/types": "workspace:*",
    "@onecore/utilities": "workspace:*",
    "@sendgrid/mail": "^8.1.6",
    "dotenv": "^16.6.1",
    "he": "^1.2.0",
    "knex": "^3.3.0",
    "koa": "^2.16.4",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-okapi-router": "^0.1.4",
    "koa-pino-logger": "^4.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "striptags": "^3.2.0",
    "tedious": "^18.6.2",
    "telefonnummer": "^2.1.0",
    "tslib": "^2.8.1",
    "validator": "^13.15.35",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/he": "^1.2.3",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.2",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-pino-logger": "3.0.4",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "12.0.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui": "^3.52.4",
    "@types/validator": "^13.15.10",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
