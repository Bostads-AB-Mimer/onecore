{
  "name": "@onecore/property",
  "version": "1.5.0",
  "description": "POC to investigate Prisma as data-layer between Xpand and ONECore",
  "license": "MIT",
  "homepage": "https://github.com/Bostads-AB-Mimer/property-base#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bostads-AB-Mimer/property-base.git"
  },
  "bugs": {
    "url": "https://github.com/Bostads-AB-Mimer/property-base/issues"
  },
  "author": "",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "nodemon -e ts,js --exec ts-node -r tsconfig-paths/register src/index",
    "dev:init": "pnpm prepare:dotenv",
    "generate:static": "pnpm prisma:generate",
    "prepare:dotenv": "[ -f .env ] || cp .env.template .env",
    "prettier": "prettier --check ./src",
    "prisma:force-generate": "pnpm clean-install --workspace . && prisma generate",
    "prisma:generate": "npx prisma generate",
    "seed:property-areas": "ts-node -r tsconfig-paths/register src/scripts/seed-property-areas.ts",
    "backfill:kvv-area-names": "ts-node -r tsconfig-paths/register src/scripts/backfill-kvv-area-names.ts",
    "start": "ts-node src/index.ts",
    "test:borked": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.2",
    "@onecore/types": "workspace:*",
    "@onecore/utilities": "workspace:*",
    "@prisma/client": "^5.22.0",
    "axios": "^1.19.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "fishery": "^2.4.0",
    "knex": "^3.3.0",
    "koa": "^2.16.4",
    "koa-body": "^6.0.1",
    "koa2-swagger-ui": "^5.12.0",
    "lodash": "^4.18.1",
    "prisma": "^5.22.0",
    "swagger-jsdoc": "^6.3.0",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "zod": "^3.25.76",
    "zod-prisma-types": "^3.3.11",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.2",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "12.0.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
