model OnecoreKvvAreaException {
  // 'building' is the only accepted objectType today; the generic shape lets
  // 'rentalObject'/'parkingArea' exceptions land later without a migration.
  objectType   String   @map("object_type") @db.NVarChar(30)
  code         String   @db.NVarChar(30)
  kvvAreaId    String   @map("kvv_area_id") @db.UniqueIdentifier
  // Denormalised from babuf at write time: which properties are split must be
  // answerable without an Xpand query.
  propertyCode String   @map("property_code") @db.NVarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime
  updatedBy    String?  @map("updated_by") @db.NVarChar(255)

  kvvArea OnecoreKvvArea @relation(fields: [kvvAreaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([objectType, code])
  @@index([kvvAreaId])
  @@index([propertyCode])
  @@map("onecore_kvv_area_exception")
}
