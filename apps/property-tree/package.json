{
  "name": "@onecore/property-tree",
  "version": "1.5.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "wait-on http://localhost:5050/swagger && wait-on http://localhost:5010/swagger && pnpm run generate-api-types && pnpm run generate-api-types:core && vite",
    "dev:init": "pnpm run prepare:dotenv",
    "format": "prettier --write .",
    "generate-api-types": "npx openapi-typescript http://localhost:5050/swagger.json -o ./src/services/api/generated/api-types.ts && npx prettier --write ./src/services/api/generated/api-types.ts",
    "generate-api-types:core": "npx openapi-typescript http://localhost:5010/swagger.json -o ./src/services/api/core/generated/api-types.ts && npx prettier --write ./src/services/api/core/generated/api-types.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepare:dotenv": "[ -f .env ] || cp .env.local.example .env",
    "prettier": "prettier --check ./src",
    "start": "vite",
    "start:server": "node --import tsx src/server/api.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.10",
    "@deck.gl/layers": "^9.3.10",
    "@deck.gl/react": "^9.3.10",
    "@dnd-kit/core": "^6.3.1",
    "@headlessui/react": "^1.7.19",
    "@onecore/types": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "deck.gl": "^9.3.10",
    "dotenv": "^16.6.1",
    "framer-motion": "^11.18.2",
    "http-proxy-middleware": "^3.0.7",
    "lucide-react": "^0.462.0",
    "maplibre-gl": "5.7.0",
    "nuqs": "^2.9.5",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "react-map-gl": "^8.1.2",
    "react-router-dom": "^6.30.4",
    "tailwind-merge": "^2.6.1",
    "ts-pattern": "^5.9.0",
    "vite": "^6.4.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "openapi-fetch": "^0.13.8",
    "openapi-typescript": "^6.7.6",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.5"
  }
}
