{
  "name": "@onecore/leasing-portal-frontend",
  "version": "1.5.0",
  "type": "module",
  "private": true,
  "description": "ONECore leasing portal pages, with a standalone shell",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "files": [
    "dist/lib"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:app",
    "build:app": "vite build",
    "build:lib": "tsup",
    "dev": "vite",
    "dev:init": "pnpm run prepare:dotenv",
    "generate-api-types": "npx openapi-typescript http://localhost:7002/leasing-portal/openapi.json -o ./src/api/generated/api-types.ts && npx prettier --write ./src/api/generated/api-types.ts",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "prepare:dotenv": "[ -f .env ] || cp .env.local.example .env",
    "prettier": "prettier --check ./src ./test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^6.30.6"
  },
  "dependencies": {
    "@onecore/types": "workspace:*",
    "@onecore/ui": "workspace:*",
    "lucide-react": "^0.462.0",
    "openapi-fetch": "^0.13.8"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^6.7.6",
    "postcss": "^8.5.27",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
