{
  "name": "@onecore/leasing-portal-backend",
  "version": "1.5.0",
  "private": true,
  "description": "Backend for frontend for the ONECore leasing portal",
  "license": "AGPL-3.0",
  "author": "",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsup",
    "dev": "node --import tsx --watch src/index",
    "dev:init": "pnpm prepare:dotenv",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "prepare:dotenv": "[ -f .env ] || cp .env.template .env",
    "prettier": "prettier --check ./src ./test",
    "start": "node build/index",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iteam/config": "^12.1.2",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.2",
    "@onecore/types": "workspace:*",
    "@onecore/utilities": "workspace:*",
    "axios": "^1.20.0",
    "dotenv": "^16.6.1",
    "koa": "^2.16.4",
    "koa-body": "^6.0.1",
    "koa-okapi-router": "^0.1.4",
    "koa2-swagger-ui": "^5.12.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.2",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "12.0.4",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
