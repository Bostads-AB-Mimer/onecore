{
  "name": "@onecore/keycloak-theme",
  "version": "1.0.0",
  "description": "Mimer login theme for the tenant realm in Keycloak",
  "private": true,
  "scripts": {
    "build": "./scripts/build.sh",
    "preview": "pnpm build && docker compose up -d && ./scripts/setup-realm.sh",
    "preview:stop": "docker compose stop",
    "format": "prettier --write src theme test",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "prettier": "prettier --check src theme test",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "personnummer": "^3.2.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
